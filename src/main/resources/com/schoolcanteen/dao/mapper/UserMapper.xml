<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.schoolcanteen.dao.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.schoolcanteen.entity.User">
        <id property="userid" column="user_id" />
        <result property="phone" column="phone" />
        <result property="password" column="password" />
        <result property="userName" column="user_name" />
        <result property="userType" column="user_type" />
        <result property="status" column="status" />
        <result property="gender" column="gender" />
        <result property="relateId" column="relate_id" />
        <result property="permissions" column="permissions" />
    </resultMap>

    <select id="selectAll" resultMap="UserResultMap">
        SELECT user_id, phone, password, user_name, user_type, status, gender, relate_id, permissions
        FROM t_user
    </select>

    <select id="selectByUserid" resultMap="UserResultMap">
        SELECT * FROM t_user WHERE user_id = #{userid}
    </select>

    <select id="selectByPhone" resultMap="UserResultMap">
        SELECT * FROM t_user WHERE phone = #{phone}
    </select>

    <insert id="insert" parameterType="com.schoolcanteen.entity.User" useGeneratedKeys="true" keyProperty="userid">
        INSERT INTO t_user (phone, password, user_name, user_type, status, gender, relate_id, permissions)
        VALUES (#{phone}, #{password}, #{userName}, #{userType}, #{status}, #{gender}, #{relateId}, #{permissions})
    </insert>

    <update id="update" parameterType="com.schoolcanteen.entity.User">
        UPDATE t_user
        SET phone = #{phone},
            user_name = #{userName},
            user_type = #{userType},
            status = #{status},
            gender = #{gender},
            relate_id = #{relateId},
            permissions = #{permissions}
        WHERE user_id = #{userid}
    </update>

    <delete id="delete">
        DELETE FROM t_user WHERE user_id = #{userid}
    </delete>

    <update id="updatePassword">
        UPDATE t_user SET password = #{password} WHERE user_id = #{userid}
    </update>

    <update id="updateStatus">
        UPDATE t_user SET status = #{status} WHERE user_id = #{userid}
    </update>

    <select id="selectByUserType" resultMap="UserResultMap">
        SELECT * FROM t_user WHERE user_type = #{userType}
    </select>
</mapper>